  "ProfilePanel" -> "Profilo" [dir=both, arrowtail=odiamond, arrowhead=none, style=solid];
  "LeaderboardPanel" -> "Profilo" [dir=both, arrowtail=odiamond, arrowhead=none, style=solid];

  // ---- associazione navigabile: freccia aperta ----
  "Personaggio" -> "Direzione" [arrowhead=vee, style=solid];
  "Proiettile" -> "Direzione" [arrowhead=vee, style=solid];
  "Livello" -> "Tile" [arrowhead=vee, style=solid, label="mappa 11x48"];
  "GameController" -> "GameState" [arrowhead=vee, style=solid];
  "GamePanel" -> "Direzione" [arrowhead=vee, style=solid, label="ORDINE_RIGHE"];

  "NemicoBase" -> "Direzione" [arrowhead=vee, style=solid, label="ciclo 4"];

  // ---- dipendenza: tratteggio, freccia aperta ----
  "Livello1" -> "NemicoFactory" [arrowhead=vee, style=dashed];
  "Livello1" -> "MostroTilapia" [arrowhead=vee, style=dashed, label="crea"];
  "GameController" -> "AudioManager" [arrowhead=vee, style=dashed];
  "GameController" -> "Evento" [arrowhead=vee, style=dashed, label="legge"];
  "Personaggio" -> "Evento" [arrowhead=vee, style=dashed, label="notifica"];
  "Link" -> "SpadaFinale" [arrowhead=vee, style=dashed, label="crea"];
  "Cristallo" -> "Link" [arrowhead=vee, style=dashed, label="applicaEffetto"];
  "Rupia" -> "Link" [arrowhead=vee, style=dashed, label="applicaEffetto"];
  "MappaLivello1" -> "Tile" [arrowhead=vee, style=dashed];
  "JZelda" -> "GameController" [arrowhead=vee, style=dashed];
  "JZelda" -> "GameView" [arrowhead=vee, style=dashed];

  // ---- ordine dei package: Model in alto, poi Controller, poi View ----
  "Personaggio"    -> "GameController" [style=invis, weight=100];
  "Livello"        -> "GameController" [style=invis, weight=100];
  "GameController" -> "GameView"       [style=invis, weight=100];
  "GameController" -> "GamePanel"      [style=invis, weight=100];

  // ---- note sulle famiglie ripetitive ----
  nota1 [shape=note, style=solid, fontsize=10, label="Livello1 e' mostrato come rappresentante:\nLivello2 ... Livello8 hanno la stessa struttura\ne cambiano solo minion e boss."];
  nota1 -> "Livello1" [style=dotted, arrowhead=none];
  nota2 [shape=note, style=solid, fontsize=10, label="MappaLivello1 e' mostrata come rappresentante:\nMappaLivello2 ... MappaLivello8 cambiano solo\nle tile associate alle immagini."];
  nota2 -> "MappaLivello1" [style=dotted, arrowhead=none];
  nota3 [shape=note, style=solid, fontsize=10, label="Crociato rappresenta i boss di mischia:\nBarbero, LinkCattivo."];
  nota3 -> "Crociato" [style=dotted, arrowhead=none];
  nota4 [shape=note, style=solid, fontsize=10, label="MostroTilapia rappresenta i boss a distanza:\nVespasiano, Gandalf, Morgana, Sauron."];
  nota4 -> "MostroTilapia" [style=dotted, arrowhead=none];
  nota5 [shape=note, style=solid, fontsize=10, label="GameConstants e' usata da tutti i package;\nqui sono disegnate solo tre dipendenze\nrappresentative per leggibilita'."];
  nota5 -> "GameConstants" [style=dotted, arrowhead=none];
}
