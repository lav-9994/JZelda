digraph JZelda {
  rankdir=TB; nodesep=0.4; ranksep=1.1; compound=true; splines=polyline;
  graph [fontname="Helvetica", bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, color=black];
  edge  [fontname="Helvetica", fontsize=9, color=black];
  labelloc="t"; fontsize=22;
  label=<<B>Lavinia Chiacchierini &nbsp;&#8212;&nbsp; teledidattica &nbsp;&#8212;&nbsp; 2099439</B><BR/><FONT POINT-SIZE="15">JZelda &#8212; diagramma delle classi</FONT><BR/> >;

  subgraph cluster_Model {
    label="Model"; fontsize=17; style=solid; color=black; penwidth=2; margin=16;
    "Observable" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">java standard</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Observable</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addObserver(o): void<BR ALIGN="LEFT"/># setChanged(): void<BR ALIGN="LEFT"/>+ notifyObservers(arg): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Personaggio" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Personaggio</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># x: int<BR ALIGN="LEFT"/># y: int<BR ALIGN="LEFT"/># vita: int<BR ALIGN="LEFT"/># danno: int<BR ALIGN="LEFT"/># larghezza: int<BR ALIGN="LEFT"/># altezza: int<BR ALIGN="LEFT"/># direzione: Direzione<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ muovi(): void<BR ALIGN="LEFT"/>+ subisciDanno(danno): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Link" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Link</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ VITE: int<BR ALIGN="LEFT"/>+ HP_PER_VITA: int<BR ALIGN="LEFT"/>- vite: int<BR ALIGN="LEFT"/>- spada: Spada<BR ALIGN="LEFT"/>- scudo: Scudo<BR ALIGN="LEFT"/>- bonusDanno: int<BR ALIGN="LEFT"/>- rupie: int<BR ALIGN="LEFT"/>- carote: int<BR ALIGN="LEFT"/>- cristalli: int<BR ALIGN="LEFT"/>- ultimoDanno: long<BR ALIGN="LEFT"/>- COOLDOWN_DANNO: long<BR ALIGN="LEFT"/>- scudoAttivo: boolean<BR ALIGN="LEFT"/>- attaccando: boolean<BR ALIGN="LEFT"/>- ultimoCristallo: long<BR ALIGN="LEFT"/>- DURATA_POSA_CRISTALLO: long<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ muovi(): void<BR ALIGN="LEFT"/>+ attacca(): void<BR ALIGN="LEFT"/>+ terminaAttacco(): void<BR ALIGN="LEFT"/>+ attivaScudo(): void<BR ALIGN="LEFT"/>+ disattivaScudo(): void<BR ALIGN="LEFT"/>+ subisciDanno(danno): void<BR ALIGN="LEFT"/>+ subisciDannoProiettile(danno): void<BR ALIGN="LEFT"/>+ equipaggiaSpada(spada): void<BR ALIGN="LEFT"/>+ equipaggiaScudo(scudo): void<BR ALIGN="LEFT"/>+ aumentaDanno(): void<BR ALIGN="LEFT"/>+ aggiungiCristallo(): void<BR ALIGN="LEFT"/>+ staMostrandoCristallo(): boolean<BR ALIGN="LEFT"/>+ usaCarota(): void<BR ALIGN="LEFT"/>+ aggiungiRupie(quantita): void<BR ALIGN="LEFT"/>+ rimuoviRupie(quantita): void<BR ALIGN="LEFT"/>+ aggiungiCarote(quantita): void<BR ALIGN="LEFT"/>+ rimuoviCarota(): void<BR ALIGN="LEFT"/>+ aggiungiVita(): void<BR ALIGN="LEFT"/>+ reset(): void<BR ALIGN="LEFT"/>+ riposiziona(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Nemico" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Nemico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># vivo: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ muovi(): void<BR ALIGN="LEFT"/>+ infliggiDanno(p): void<BR ALIGN="LEFT"/>+ subisciDanno(danno): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "NemicoBase" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>NemicoBase</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- xIniziale: int<BR ALIGN="LEFT"/>- yIniziale: int<BR ALIGN="LEFT"/>- RANGE_MOVIMENTO: int<BR ALIGN="LEFT"/>- ciclo: Direzione[]<BR ALIGN="LEFT"/>- faseCorrente: int<BR ALIGN="LEFT"/>- ritorno: boolean<BR ALIGN="LEFT"/>- random: Random<BR ALIGN="LEFT"/>- contatoreFrame: int<BR ALIGN="LEFT"/>- rupieRilasciate: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tempoDiMuoversi(): boolean<BR ALIGN="LEFT"/>+ rimbalza(): void<BR ALIGN="LEFT"/>+ muovi(): void<BR ALIGN="LEFT"/>- raggiuntaLimite(dir): boolean<BR ALIGN="LEFT"/>- tornatoAlCentro(dir): boolean<BR ALIGN="LEFT"/>+ subisciDanno(danno): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "BossMischia" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>BossMischia</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># xBase: int<BR ALIGN="LEFT"/># yBase: int<BR ALIGN="LEFT"/># RANGE_BOSS: int<BR ALIGN="LEFT"/># cooldownAttacco: long<BR ALIGN="LEFT"/># ultimoAttacco: long<BR ALIGN="LEFT"/>- frameTimer: int<BR ALIGN="LEFT"/>- fotogramma: int<BR ALIGN="LEFT"/>- FRAME_PER_FOTOGRAMMA: int<BR ALIGN="LEFT"/>- FOTOGRAMMI_CAMMINATA: int<BR ALIGN="LEFT"/>- DURATA_POSA_ATTACCO: long<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aggiorna(linkX, linkY): void<BR ALIGN="LEFT"/>- avanzaCamminata(siStaMuovendo): void<BR ALIGN="LEFT"/>+ muoviVersoLink(linkX, linkY): void<BR ALIGN="LEFT"/>+ muovi(): void<BR ALIGN="LEFT"/>+ puoAttaccare(): boolean<BR ALIGN="LEFT"/>+ attacca(link): void<BR ALIGN="LEFT"/>+ subisciDanno(danno): void<BR ALIGN="LEFT"/>+ staAttaccando(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "BossDistanza" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>BossDistanza</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># proiettili: List&lt;Proiettile&gt;<BR ALIGN="LEFT"/># cooldownAttacco: long<BR ALIGN="LEFT"/># ultimoAttacco: long<BR ALIGN="LEFT"/>- intervalloRaffica: long<BR ALIGN="LEFT"/>- durataAttacco: long<BR ALIGN="LEFT"/>- durataPausa: long<BR ALIGN="LEFT"/>- faseAttacco: boolean<BR ALIGN="LEFT"/>- tempoInizioFase: long<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ muovi(): void<BR ALIGN="LEFT"/>+ iniziaCombattimento(): void<BR ALIGN="LEFT"/>+ spara(linkX, linkY): void<BR ALIGN="LEFT"/>+ rimuoviProiettiliInattivi(): void<BR ALIGN="LEFT"/>+ subisciDanno(danno): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Crociato" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Crociato</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- VITA: int<BR ALIGN="LEFT"/>- DANNO: int<BR ALIGN="LEFT"/>- COOLDOWN: long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "MostroTilapia" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>MostroTilapia</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- VITA: int<BR ALIGN="LEFT"/>- DANNO: int<BR ALIGN="LEFT"/>- INTERVALLO_RAFFICA: long<BR ALIGN="LEFT"/>- DURATA_ATTACCO: long<BR ALIGN="LEFT"/>- DURATA_PAUSA: long<BR ALIGN="LEFT"/>- frameTimer: int<BR ALIGN="LEFT"/>- pinneAperte: boolean<BR ALIGN="LEFT"/>- FRAME_PER_POSA: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aggiorna(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Coniglietti" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Coniglietti</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- speciale: boolean<BR ALIGN="LEFT"/>- attivo: boolean<BR ALIGN="LEFT"/>- saltando: boolean<BR ALIGN="LEFT"/>- contatoreSalto: int<BR ALIGN="LEFT"/>- FRAME_SALTO: int<BR ALIGN="LEFT"/>- FRAME_PAUSA: int<BR ALIGN="LEFT"/>- fugaX: int<BR ALIGN="LEFT"/>- fugaY: int<BR ALIGN="LEFT"/>- fugaDecisa: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- decidiFuga(linkX, linkY): void<BR ALIGN="LEFT"/>- avanzaSalto(): boolean<BR ALIGN="LEFT"/>+ muovi(): void<BR ALIGN="LEFT"/>+ muoviLontanoDa(linkX, linkY): void<BR ALIGN="LEFT"/>+ muoviVerso(linkX, linkY): void<BR ALIGN="LEFT"/>+ interagisciConLink(link): void<BR ALIGN="LEFT"/>+ disattiva(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Proiettile" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Proiettile</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- x: int<BR ALIGN="LEFT"/>- y: int<BR ALIGN="LEFT"/>- LARGHEZZA: int<BR ALIGN="LEFT"/>- ALTEZZA: int<BR ALIGN="LEFT"/>- direzione: Direzione<BR ALIGN="LEFT"/>- danno: int<BR ALIGN="LEFT"/>- attivo: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ muovi(): void<BR ALIGN="LEFT"/>+ infliggiDanno(link): void<BR ALIGN="LEFT"/>+ disattiva(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Livello" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Livello</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># numeroLivello: int<BR ALIGN="LEFT"/># mappa: Tile[][]<BR ALIGN="LEFT"/># minion: List&lt;NemicoBase&gt;<BR ALIGN="LEFT"/># boss: Nemico<BR ALIGN="LEFT"/># rupie: List&lt;Rupia&gt;<BR ALIGN="LEFT"/># cristalli: List&lt;Cristallo&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># inizializza(): void<BR ALIGN="LEFT"/>- caricaMappa(): void<BR ALIGN="LEFT"/>- riempiDiSabbia(): void<BR ALIGN="LEFT"/>+ creaRupia(x, y, valore): void<BR ALIGN="LEFT"/>+ creaCristallo(x, y): void<BR ALIGN="LEFT"/>+ rimuoviOggettiRaccolti(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Livello1" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Livello1</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># inizializza(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Tile" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Tile</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SABBIA<BR ALIGN="LEFT"/>+ ACQUA<BR ALIGN="LEFT"/>+ PIETRE<BR ALIGN="LEFT"/>+ MOSAICO<BR ALIGN="LEFT"/>+ COLONNA<BR ALIGN="LEFT"/>+ BIBLIOTECA<BR ALIGN="LEFT"/>+ LIBRERIA<BR ALIGN="LEFT"/>+ SOTTERRANEO<BR ALIGN="LEFT"/>+ SCAFFALE<BR ALIGN="LEFT"/>+ PRATO<BR ALIGN="LEFT"/>+ FIORI<BR ALIGN="LEFT"/>+ ALBERO<BR ALIGN="LEFT"/>+ ROCCIA<BR ALIGN="LEFT"/>+ LAVA<BR ALIGN="LEFT"/>+ CASTELLO<BR ALIGN="LEFT"/>+ ROVINE<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Direzione" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Direzione</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SU<BR ALIGN="LEFT"/>+ GIU<BR ALIGN="LEFT"/>+ SINISTRA<BR ALIGN="LEFT"/>+ DESTRA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "GameState" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>GameState</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MENU<BR ALIGN="LEFT"/>+ GIOCO<BR ALIGN="LEFT"/>+ SHOP<BR ALIGN="LEFT"/>+ GAME_OVER<BR ALIGN="LEFT"/>+ VITTORIA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Evento" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;enum&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Evento</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ VITA<BR ALIGN="LEFT"/>+ VITE<BR ALIGN="LEFT"/>+ SCUDO<BR ALIGN="LEFT"/>+ SCUDO_EQUIPAGGIATO<BR ALIGN="LEFT"/>+ SPADA<BR ALIGN="LEFT"/>+ BONUS_DANNO<BR ALIGN="LEFT"/>+ CRISTALLO<BR ALIGN="LEFT"/>+ RUPIE<BR ALIGN="LEFT"/>+ CAROTE<BR ALIGN="LEFT"/>+ GAME_OVER<BR ALIGN="LEFT"/>+ ATTACCO_LINK<BR ALIGN="LEFT"/>+ DANNO_SUBITO<BR ALIGN="LEFT"/>+ MORTE_NEMICO<BR ALIGN="LEFT"/>+ MORTE_BOSS_MISCHIA<BR ALIGN="LEFT"/>+ MORTE_BOSS_DISTANZA<BR ALIGN="LEFT"/>+ ATTACCO_BOSS<BR ALIGN="LEFT"/>+ VITA_BONUS<BR ALIGN="LEFT"/>+ DANNO_CONIGLIO<BR ALIGN="LEFT"/>+ CONIGLIO_DISATTIVATO<BR ALIGN="LEFT"/>+ PROFILO<BR ALIGN="LEFT"/>+ STATISTICHE<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Item" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Item</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNome(): String<BR ALIGN="LEFT"/>+ applicaEffetto(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Spada" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Spada</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># danno: int<BR ALIGN="LEFT"/># nome: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ applicaEffetto(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SpadaBase" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>SpadaBase</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ applicaEffetto(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SpadaFinale" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>SpadaFinale</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ applicaEffetto(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Scudo" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;abstract&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Scudo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"># nome: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ danniDaColpo(danno): int<BR ALIGN="LEFT"/>+ danniDaProiettile(danno): int<BR ALIGN="LEFT"/>+ applicaEffetto(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ScudoBase" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>ScudoBase</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ danniDaColpo(danno): int<BR ALIGN="LEFT"/>+ danniDaProiettile(danno): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Carote" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Carote</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ applicaEffetto(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Rupia" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Rupia</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- x: int<BR ALIGN="LEFT"/>- y: int<BR ALIGN="LEFT"/>- larghezza: int<BR ALIGN="LEFT"/>- altezza: int<BR ALIGN="LEFT"/>- valore: int<BR ALIGN="LEFT"/>- raccolta: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ applicaEffetto(link): void<BR ALIGN="LEFT"/>+ raccogli(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Cristallo" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Cristallo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- x: int<BR ALIGN="LEFT"/>- y: int<BR ALIGN="LEFT"/>- larghezza: int<BR ALIGN="LEFT"/>- altezza: int<BR ALIGN="LEFT"/>- raccolto: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ applicaEffetto(link): void<BR ALIGN="LEFT"/>+ raccogli(link): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Shop" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Shop</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- itemDisponibili: List&lt;Item&gt;<BR ALIGN="LEFT"/>+ PREZZO_CAROTA: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ acquista(link): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Profilo" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>Profilo</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- filePath: Path<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aggiungiProfilo(nickname, avatar): void<BR ALIGN="LEFT"/>+ aggiornaStatistiche(nickname, vinta): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "NemicoFactory" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>NemicoFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ creaNemico(livello, x, y): NemicoBase<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SpawnaConiglietti" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">&laquo;interface&raquo;</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SpawnaConiglietti</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SPARPAGLIAMENTO: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ spawnaConiglietti(x, y): List&lt;Coniglietti&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  subgraph cluster_Controller {
    label="Controller"; fontsize=17; style=solid; color=black; penwidth=2; margin=16;
    "GameController" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>GameController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- FPS: int<BR ALIGN="LEFT"/>- TARGET_TIME: long<BR ALIGN="LEFT"/>- link: Link<BR ALIGN="LEFT"/>- view: GameView<BR ALIGN="LEFT"/>- profilo: Profilo<BR ALIGN="LEFT"/>- inputHandler: InputHandler<BR ALIGN="LEFT"/>- collisionController: CollisionController<BR ALIGN="LEFT"/>- livelloCorrente: Livello<BR ALIGN="LEFT"/>- numeroLivelloCorrente: int<BR ALIGN="LEFT"/>- statoGioco: GameState<BR ALIGN="LEFT"/>- coniglietti: List&lt;Coniglietti&gt;<BR ALIGN="LEFT"/>- shop: Shop<BR ALIGN="LEFT"/>- nicknameGiocatore: String<BR ALIGN="LEFT"/>- gameThread: Thread<BR ALIGN="LEFT"/>- schermataCorrente: int<BR ALIGN="LEFT"/>- cameraX: int<BR ALIGN="LEFT"/>- cameraXTarget: int<BR ALIGN="LEFT"/>- VELOCITA_CAMERA: int<BR ALIGN="LEFT"/>- AVANZAMENTO_LINK: int<BR ALIGN="LEFT"/>- frameTransizione: int<BR ALIGN="LEFT"/>- bossAttivato: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- setupListeners(): void<BR ALIGN="LEFT"/>+ iniziaPartita(): void<BR ALIGN="LEFT"/>- caricaLivello(numero): void<BR ALIGN="LEFT"/>- prossimoLivello(): void<BR ALIGN="LEFT"/>- avviaGameLoop(): void<BR ALIGN="LEFT"/>+ run(): void<BR ALIGN="LEFT"/>- aggiornaGioco(): void<BR ALIGN="LEFT"/>- inTransizione(): boolean<BR ALIGN="LEFT"/>- avanzaTransizione(): void<BR ALIGN="LEFT"/>- aggiornaCamera(): void<BR ALIGN="LEFT"/>- bloccatoNellArenaDelBoss(dx): boolean<BR ALIGN="LEFT"/>- gestisciInput(): void<BR ALIGN="LEFT"/>- aggiornaNemici(): void<BR ALIGN="LEFT"/>- aggiornaBoss(): void<BR ALIGN="LEFT"/>- aggiornaConiglietti(): void<BR ALIGN="LEFT"/>- verificaCompletamentoLivello(): void<BR ALIGN="LEFT"/>+ update(o, arg): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "CollisionController" [shape=none, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3"><TR><TD ALIGN="CENTER"><B>CollisionController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- link: Link<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- collidono(a, b): boolean<BR ALIGN="LEFT"/>- collidonoProiettile(a, p): boolean<BR ALIGN="LEFT"/>- linkStaColpendo(p): boolean<BR ALIGN="LEFT"/>+ gestisciCollisioni(livello, coniglietti): void<BR ALIGN="LEFT"/>- gestisciRaccoltaOggetti(livello): void<BR ALIGN="LEFT"/>- gestisciCollisioniNemici(nemici): void<BR ALIGN="LEFT"/>+ fuoriDallaMappa(p, dx, dy): boolean<BR ALIGN="LEFT"/>+ bloccatoDaTile(p, dx, dy, mappa): boolean<BR ALIGN="LEFT"/>+ chiSullaStrada(p, dx, dy, altriPersonaggi): Personaggio<BR ALIGN="LEFT"/>- gestisciCollisioneBoss(boss, coniglietti): void<BR ALIGN="LEFT"/>- gestisciCollisioniConiglietti(coniglietti): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
